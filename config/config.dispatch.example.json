{
  "version": 1,
  "drive": {
    "remote": "gdrive",
    "parent_folder_id": "",
    "parent_folder_name": "AI Project Operations",
    "root_folder_id": "",
    "root_folder_name": "03 — Agent Execution Reports"
  },
  "projects": {
    "project-a": {
      "name": "ProjectA",
      "drive_folder_id": "",
      "paths": ["/home/dev/projects/project-a"],
      "path_prefixes": [],
      "aliases": ["project-a"],
      "auto_registered": false
    },
    "project-b": {
      "name": "ProjectB",
      "drive_folder_id": "",
      "paths": ["/home/dev/projects/project-b"],
      "path_prefixes": [],
      "aliases": ["project-b"],
      "auto_registered": false
    }
  },
  "workspace_roots": ["/home/dev/projects"],
  "auto_register_projects": false,
  "upload": {
    "enabled": true,
    "auto_upload": true,
    "verify": true,
    "timeout_seconds": 120,
    "hook_timeout_seconds": 25,
    "max_attempts": 0,
    "verify_interval_minutes": 60
  },
  "integrations": {"opencode": true, "agy": false},
  "security": {
    "redact_uploads": true,
    "max_prompt_bytes": 200000,
    "max_summary_bytes": 50000
  },
  "index": {"include_pending_local": true, "max_open_issues": 20},
  "dispatch": {
    "enabled": false,
    "transport": "github_issues",
    "repository": "example-user/private-dispatch",
    "allowed_users": ["example-user"],
    "agent": "opencode",
    "models": {
      "fast": "provider/model-fast",
      "review": "provider/model-review"
    },
    "default_model": "fast",
    "projects": {
      "ProjectA": {"workspace": "/home/dev/projects/project-a"},
      "ProjectB": {
        "workspace": "/srv/agent-handoff/work/project-b",
        "execution": {
          "permission_profile": "workspace_write",
          "allow_write": true,
          "isolation": {"enabled": true}
        },
        "coding": {
          "enabled": false,
          "repository": "example-user/project-b",
          "base_branch": "main",
          "workspace_root": "/srv/agent-handoff/coding/project-b",
          "test_profile": "python",
          "allowed_model_aliases": ["fast"],
          "protected_paths": [".github/workflows/**", "config/config.json"],
          "allowed_paths": [],
          "cleanup_on_success": true
        }
      }
    },
    "poll_interval_seconds": 30,
    "execution": {
      "timeout_seconds": 1200,
      "max_prompt_bytes": 50000,
      "permission_profile": "read_only",
      "allow_write": false,
      "isolation": {
        "enabled": false,
        "environment": "allowlist",
        "identity": {
          "user": "agent-handoff-dev",
          "group": "agent-handoff-dev",
          "home": "/srv/agent-handoff/home/agent-handoff-dev"
        },
        "workspace_roots": ["/srv/agent-handoff/work"],
        "child_path": "/usr/local/bin:/usr/bin:/bin"
      }
    },
    "coding": {
      "enabled": false,
      "staging_root": "/srv/agent-handoff/state/coding-publication",
      "limits": {
        "test_timeout_seconds": 900,
        "max_files_changed": 25,
        "max_diff_bytes": 500000,
        "max_file_bytes": 200000,
        "max_output_bytes": 50000,
        "max_workspace_bytes": 2000000000,
        "max_coding_tasks": 1,
        "max_publication_attempts": 3,
        "max_test_memory_bytes": 2000000000,
        "max_test_processes": 128,
        "max_test_file_bytes": 256000000
      },
      "publication": {
        "draft": true,
        "branch_prefix": "agent-handoff/",
        "max_attempts": 3,
        "pr_title_prefix": "Agent Handoff: ",
        "token_env": null
      },
      "protected_paths": [".github/workflows/**", ".github/actions/**", ".gitmodules", ".env", ".env.*"],
      "secret_scan": true,
      "test_profiles": {
        "python": {
          "description": "Example trusted Python profile",
          "commands": [
            ["python3", "-m", "compileall", "-q", "lib", "setup", "tests"],
            ["sh", "-n", "setup/install.sh", "setup/upgrade.sh", "setup/rollback.sh", "setup/gdrive-auth.sh"],
            ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v"]
          ],
          "timeout_seconds": 900,
          "env": {"PYTHONHASHSEED": "0", "PYTHONPATH": "lib"}
        }
      }
    },
    "delivery": {"retry_seconds": 60, "max_attempts": 0},
    "github": {"command": "gh", "require_private": true}
  },
  "notifications": {
    "telegram": {
      "enabled": false,
      "chat_id": "",
      "token_env": "AGENT_HANDOFF_TELEGRAM_TOKEN",
      "timeout_seconds": 10,
      "retry_seconds": 60,
      "max_attempts": 5,
      "delayed_after_attempts": 3
    }
  }
}
