{
  "version": 1,
  "drive": {
    "remote": "gdrive",
    "parent_folder_id": "",
    "parent_folder_name": "AI Project Operations",
    "root_folder_id": "",
    "root_folder_name": "03 — Agent Execution Reports"
  },
  "projects": {},
  "workspace_roots": [
    "/home/dev/projects"
  ],
  "auto_register_projects": true,
  "upload": {
    "enabled": true,
    "auto_upload": true,
    "verify": true,
    "timeout_seconds": 120,
    "hook_timeout_seconds": 25,
    "max_attempts": 0,
    "verify_interval_minutes": 60
  },
  "integrations": {
    "opencode": true,
    "agy": true
  },
  "security": {
    "redact_uploads": true,
    "max_prompt_bytes": 200000,
    "max_summary_bytes": 50000
  },
  "index": {
    "include_pending_local": true,
    "max_open_issues": 20
  },
  "dispatch": {
    "enabled": false,
    "transport": "github_issues",
    "repository": "",
    "allowed_users": [],
    "agent": "opencode",
    "models": {},
    "default_model": "",
    "projects": {},
    "poll_interval_seconds": 30,
    "execution": {
      "timeout_seconds": 1200,
      "max_prompt_bytes": 50000,
      "permission_profile": "read_only",
      "allow_write": false,
      "isolation": {
        "enabled": false,
        "environment": "allowlist",
        "identity": {
          "user": "agent-handoff-dev",
          "group": "agent-handoff-dev",
          "home": "/srv/agent-handoff/home/agent-handoff-dev"
        },
        "workspace_roots": ["/srv/agent-handoff/work"],
        "child_path": "/usr/local/bin:/usr/bin:/bin"
      }
    },
    "delivery": {
      "retry_seconds": 60,
      "max_attempts": 0
    },
    "github": {
      "command": "gh",
      "require_private": true
    }
  },
  "notifications": {
    "telegram": {
      "enabled": false,
      "chat_id": "",
      "token_env": "AGENT_HANDOFF_TELEGRAM_TOKEN",
      "timeout_seconds": 10,
      "retry_seconds": 60,
      "max_attempts": 5,
      "delayed_after_attempts": 3
    }
  }
}
