#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path


def root() -> Path:
    return Path(os.environ.get("FAKE_OPENCODE_DIR", "/tmp/fake-opencode")).resolve()


def log_call(record: dict) -> None:
    root().mkdir(parents=True, exist_ok=True)
    with open(root() / "calls.jsonl", "a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + "\n")


def flag(argv: list[str], name: str, default: str | None = None) -> str | None:
    if name in argv:
        index = argv.index(name)
        if index + 1 < len(argv):
            return argv[index + 1]
    return default


def main() -> int:
    argv = sys.argv[1:]
    if argv in (["--version"], ["-v"]):
        print("1.19.5")
        return 0
    if argv and argv[0] == "models":
        print("provider/model-fast")
        print("provider/model-review")
        return 0
    if not argv or argv[0] != "run":
        print(f"unsupported fake opencode command: {argv}", file=sys.stderr)
        return 1
    session = os.environ.get("FAKE_OPENCODE_SESSION", "ses_fake_00000000000000000000000000")
    message = "msg_fake_0001"
    log_call(
        {
            "pid": os.getpid(),
            "cwd": os.getcwd(),
            "PWD": os.environ.get("PWD"),
            "session": session,
            "model": flag(argv, "--model"),
            "agent": flag(argv, "--agent"),
            "title": flag(argv, "--title"),
            "format": flag(argv, "--format"),
            "prompt": argv[-1] if argv else "",
            "config_content": os.environ.get("OPENCODE_CONFIG_CONTENT"),
        }
    )
    delay = float(os.environ.get("FAKE_OPENCODE_DELAY", "0") or 0)
    if delay:
        time.sleep(delay)
    if os.environ.get("FAKE_OPENCODE_FAIL"):
        print("simulated opencode failure", file=sys.stderr)
        return int(os.environ.get("FAKE_OPENCODE_EXIT", "1"))
    now = int(time.time() * 1000)
    print(json.dumps({"type": "step_start", "timestamp": now, "sessionID": session, "part": {"messageID": message, "sessionID": session, "type": "step-start"}}))
    if not os.environ.get("FAKE_OPENCODE_NO_TEXT"):
        text = os.environ.get("FAKE_OPENCODE_TEXT", "FAKE_OPENCODE_OK")
        print(json.dumps({"type": "text", "timestamp": now + 1, "sessionID": session, "part": {"messageID": message, "sessionID": session, "type": "text", "text": text}}))
        sys.stdout.flush()
    if os.environ.get("FAKE_OPENCODE_CRASH_AFTER_TEXT"):
        os._exit(2)
    reason = os.environ.get("FAKE_OPENCODE_REASON", "stop")
    print(json.dumps({"type": "step_finish", "timestamp": now + 2, "sessionID": session, "part": {"messageID": message, "sessionID": session, "type": "step-finish", "reason": reason}}))
    return int(os.environ.get("FAKE_OPENCODE_EXIT", "0"))


if __name__ == "__main__":
    raise SystemExit(main())
