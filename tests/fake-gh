#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def root() -> Path:
    return Path(os.environ.get("FAKE_GH_DIR", "/tmp/fake-gh")).resolve()


def load(name: str, default):
    path = root() / name
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except ValueError:
        return default


def save(name: str, data) -> None:
    path = root() / name
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def log_call(argv: list[str]) -> None:
    path = root() / "calls.jsonl"
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(argv, ensure_ascii=False) + "\n")


def fail(message: str, code: int = 1) -> int:
    print(message, file=sys.stderr)
    return code


def pages(value) -> None:
    if "--slurp" in sys.argv:
        print(json.dumps([value], ensure_ascii=False))
    else:
        print(json.dumps(value, ensure_ascii=False))


def handle_api(argv: list[str]) -> int:
    values = [item for item in argv if not item.startswith("-")]
    if not values:
        return fail("api endpoint missing")
    endpoint = values[0].lstrip("/").split("?", 1)[0]
    repo = load("repo.json", {})
    user = load("user.json", {"login": "dev"})
    issues = load("issues.json", [])
    comments = load("comments.json", {})
    if endpoint == "user":
        print(json.dumps(user, ensure_ascii=False))
        return 0
    parts = endpoint.split("/")
    if len(parts) == 3 and parts[0] == "repos":
        print(json.dumps(repo, ensure_ascii=False))
        return 0
    if len(parts) >= 4 and parts[0] == "repos" and parts[3] == "issues":
        if len(parts) == 4:
            pages(issues)
            return 0
        try:
            number = int(parts[4])
        except (IndexError, ValueError):
            return fail("invalid issue number")
        if len(parts) == 5:
            for issue in issues:
                if int(issue.get("number", -1)) == number:
                    print(json.dumps(issue, ensure_ascii=False))
                    return 0
            return fail(f"issue #{number} not found")
        if len(parts) == 6 and parts[5] == "comments":
            pages(comments.get(str(number), []))
            return 0
    return fail(f"unsupported fake gh api endpoint: {endpoint}")


def handle_comment(argv: list[str]) -> int:
    if len(argv) < 2:
        return fail("comment issue number missing")
    try:
        number = int(argv[1])
    except ValueError:
        return fail("comment issue number is invalid")
    body = ""
    if "--body" in argv:
        body = argv[argv.index("--body") + 1]
    marker = os.environ.get("FAKE_GH_FAIL_COMMENT_FILE")
    if marker and Path(marker).exists():
        Path(marker).unlink()
        return fail("simulated GitHub comment outage")
    comments = load("comments.json", {})
    entries = comments.setdefault(str(number), [])
    entries.append(
        {
            "id": len(entries) + 1,
            "body": body,
            "user": load("user.json", {"login": "dev"}),
            "html_url": f"https://github.test/example/issues/{number}#issuecomment-{len(entries) + 1}",
            "created_at": "2026-11-19T00:00:00Z",
        }
    )
    save("comments.json", comments)
    print(f"https://github.test/example/issues/{number}#issuecomment-{len(entries)}")
    return 0


def main() -> int:
    root().mkdir(parents=True, exist_ok=True)
    argv = sys.argv[1:]
    log_call(argv)
    if not argv:
        return fail("no command")
    if argv[0] in ("--version", "version"):
        print("gh version 0.0.0 (fake)")
        return 0
    if argv[0] == "api":
        return handle_api(argv[1:])
    if argv[0] == "issue" and len(argv) > 1 and argv[1] == "comment":
        return handle_comment(argv[1:])
    return fail(f"unsupported fake gh command: {' '.join(argv)}")


if __name__ == "__main__":
    raise SystemExit(main())
